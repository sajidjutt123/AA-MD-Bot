{
  "name": "aa-md-bot",
  "version": "3.0.0",
  "description": "AA MD Bot - Multi-Device WhatsApp Bot by Ahsan Ali Wadani",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20.6.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node --experimental-vm-modules --env-file .env index.js",
    "start:noenv": "node --experimental-vm-modules index.js",
    "dev": "node --experimental-vm-modules --env-file .env index.js",
    "pm2": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart aa-md-bot",
    "pm2:logs": "pm2 logs aa-md-bot",
    "postinstall": "node -e \"const fs=require('fs');['logs','temp','session','downloads','database','cache'].forEach(d=>{try{fs.mkdirSync(d,{recursive:true})}catch{}});console.log('✅ Directories ready');\"",
    "prepare": "node -e \"console.log('✅ Dependencies ready')\""
  },
  "keywords": [
    "whatsapp",
    "bot",
    "md",
    "baileys",
    "oracle"
  ],
  "author": "Ahsan Ali Wadani (AA Mods)",
  "license": "MIT",
  "dependencies": {
    "@fantox01/lyrics-scraper": "^4.0.0",
    "@fantox01/search-it": "^1.0.0",
    "@gradio/client": "^2.3.1",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "archiver": "^8.0.0",
    "axios": "^1.7.0",
    "canvacord": "^6.0.4",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "figlet": "^1.11.3",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "fs-extra": "^11.2.0",
    "google-tts-api": "^2.0.2",
    "jimp": "^1.6.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "mongodb": "^7.5.0",
    "mumaker": "^2.0.0",
    "node-cache": "^5.1.2",
    "node-telegram-bot-api": "^1.2.0",
    "pg": "^8.13.1",
    "pino": "^9.4.0",
    "play-dl": "^1.9.7",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.2",
    "wa-sticker-formatter": "^4.4.4",
    "yt-dlp-wrap": "^2.3.12"
  }
}
