# ══════════════════════════════════════════════════════════════
#  AA MD Bot — Environment Variables
#
#  ✅ Oracle VM par deploy karte ho to .env auto-banta hai:
#     bash <(curl -fsSL https://raw.githubusercontent.com/ahsanaliwadani/AA-MD-Bot/main/deploy/setup.sh)
#
#  Manual setup ke liye neeche dekho:
#     cp .env.example .env && nano .env
# ══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
PORT=5000
SERVER_ID=server-1

# ── Database ──────────────────────────────────────────────────
# Two supported backends. Supabase (Postgres) wins when both are set.
#
# 1) SUPABASE (recommended for 24/7 + Vercel dashboards)
#    Supabase Dashboard → Project Settings → Database → Connection string →
#    "Session pooler" (IPv4 friendly, required on many hosts):
#      postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#    Then run supabase/schema.sql once in the Supabase SQL editor.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_POOL_MAX=5
#
# 2) MONGODB (works out of the box on the Oracle VM installer)
# Oracle VM deploy: auto-set hota hai — kuch karne ki zaroorat nahi
# Manual: MongoDB URI yahan paste karo
MONGODB_URI=mongodb://aa_bot_user:PASSWORD@127.0.0.1:27017/aa_md_bot?authSource=aa_md_bot
# Legacy Atlas shorthand — only used when MONGODB_URI is unset
# MONGODB_PASSWORD=
# MONGODB_USER=a67515346_db_user
# MONGODB_HOST=aa-md-bot.i1j26yw.mongodb.net

# ── Security ──────────────────────────────────────────────────
# REQUIRED for the dashboard API. Every protected route (session create/delete,
# QR, pairing code, /events, /stats) needs it as a bearer token:
#   curl -H "Authorization: Bearer $SESSION_SECRET" http://host:5000/stats
# If unset, an ephemeral token is generated at boot and printed in the logs.
# Oracle VM deploy: auto-generate hota hai
SESSION_SECRET=change_this_to_a_random_64_char_string

# Extra browser origins allowed to call the API (comma separated).
# localhost:5000 and https://aa-md-bot.vercel.app are always allowed.
# Add your own Vercel URL here once the dashboard is deployed:
# DASHBOARD_ORIGINS=https://my-dashboard.example.com,https://my-dashboard-git-main-me.vercel.app


# ── Bot identity ──────────────────────────────────────────────
# Owner numbers (comma separated, digits only, no + sign)
OWNER_NUMBER=923316041183
# Super owner — full control (eval, shell, restart)
SUPER_OWNER=923346741532
# Telegram user id allowed to use /broadcast /sessions /disconnect
# TELEGRAM_OWNER_ID=6001083166
# CHANNEL_LINK=https://whatsapp.com/channel/0029Vb8Yk2LL2AU78HliE617

# ── Telegram (optional) ───────────────────────────────────────
# TELEGRAM_BOT_TOKEN=          # @BotFather se lena
# TELEGRAM_FEATURES_BOT_TOKEN= # second bot token

# ── API Keys (optional) ───────────────────────────────────────
# OPENWEATHER_API_KEY=   # .weather command ke liye
# OMDB_API_KEY=          # .movie command ke liye
# RAPIDAPI_KEY=
# OCR_SPACE_KEY=         # .ocr command ke liye
# HF_TOKEN=              # AI commands ke liye
# TENOR_API_KEY=         # GIF search ke liye
